# 子應用入口不長快取，部署後才能立刻載入帶新 hash 的 JS/CSS
/xunxing/
  Cache-Control: no-cache, must-revalidate

/xunxing/index.html
  Cache-Control: no-cache, must-revalidate

/copybook/
  Cache-Control: no-cache, must-revalidate

/copybook/index.html
  Cache-Control: no-cache, must-revalidate

/copybook/app.js
  Cache-Control: no-cache, must-revalidate

/copybook/style.css
  Cache-Control: no-cache, must-revalidate

/ru-shi/
  Cache-Control: no-cache, must-revalidate

/ru-shi/index.html
  Cache-Control: no-cache, must-revalidate

/ru-shi/js/*
  Cache-Control: no-cache, must-revalidate

/ru-shi/css/*
  Cache-Control: no-cache, must-revalidate

/copybook/backgrounds/*
  Cache-Control: public, max-age=0, must-revalidate

/copybook/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/taoyuan-wanxiang-monopoly/
  Cache-Control: no-cache, must-revalidate

/taoyuan-wanxiang-monopoly/index.html
  Cache-Control: no-cache, must-revalidate

/taoyuan-wanxiang-monopoly/assets/*
  Cache-Control: public, max-age=31536000, immutable

/shanhaijing-landing/
  Cache-Control: no-cache, must-revalidate

/shanhaijing-landing/index.html
  Cache-Control: no-cache, must-revalidate

/shanhaijing-landing/assets/*
  Cache-Control: public, max-age=31536000, immutable

/shanhaijing-landing/audio/*
  Cache-Control: public, max-age=31536000, immutable

/mawangdui-silk/
  Cache-Control: no-store, must-revalidate
  CDN-Cache-Control: no-store

/enjoyread/app.html
  Cache-Control: no-cache, must-revalidate

/mawangdui-silk/*
  Cache-Control: no-store, must-revalidate
  CDN-Cache-Control: no-store
